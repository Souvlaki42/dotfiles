[user]
	name = Souvlaki42
  email = ilias@moulas.dev
  signingkey = ~/.ssh/id_ed25519.pub

[gpg]
  format = ssh

[commit]
  gpgsign = true

[tag]
  gpgsign = true

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true
	default = current

[core]
	autocrlf = input # Convert CRLF to LF on commit, no reverse conversion
  safecrlf = false   # Don't warn about CRLF on commit
  eol = lf          # Use LF as EOL
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true  # use n and N to move between diff sections
  dark = true      # or light = true, or omit for auto-detection
  side-by-side = true
  line-numbers = true
  paging = never
  hyperlinks = true
  hyperlinks-file-link-format = "lazygit-edit://{path}:{file}"

[merge]
  conflictStyle = zdiff3

[diff]
  algorithm = histogram
  colorMoved = default
  mnemonicPrefix = true

[rerere]
  enabled = true
  autoupdate = true

[alias]
	st = status -s
	sta = status
	conf = config --global --edit
	undo = reset --soft HEAD^
	ci = commit
	co = checkout
	cod = checkout .
	rh = reset HEAD
	aa = add -A
	cdf = clean -df
	pr = pull --rebase
	br = branch
	bra = branch -a
	amend = commit -a --amend --no-edit
	pfl = push --force-with-lease

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
